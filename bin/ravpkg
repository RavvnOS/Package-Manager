#!/usr/bin/env bash
# bin/ravpkg - Main executable for ravynOS package manager
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(dirname "$SCRIPT_DIR")"

# Determine library directory location
if [[ -f "$ROOT_DIR/lib/db.sh" ]]; then
    LIB_DIR="$ROOT_DIR/lib"
    SCHEMA_FILE="$ROOT_DIR/schema/schema.sql"
elif [[ -f "/usr/local/lib/ravpkg/db.sh" ]]; then
    LIB_DIR="/usr/local/lib/ravpkg"
    SCHEMA_FILE="/usr/local/lib/ravpkg/schema.sql"
elif [[ -f "/usr/lib/ravpkg/db.sh" ]]; then
    LIB_DIR="/usr/lib/ravpkg"
    SCHEMA_FILE="/usr/lib/ravpkg/schema.sql"
else
    echo "Error: unable to locate ravpkg libraries (lib/db.sh)" >&2
    exit 1
fi

# Source core engine libraries
# shellcheck source=lib/db.sh
source "$LIB_DIR/db.sh"
# shellcheck source=lib/parser.sh
source "$LIB_DIR/parser.sh"
# shellcheck source=lib/install.sh
source "$LIB_DIR/install.sh"
# shellcheck source=lib/remove.sh
source "$LIB_DIR/remove.sh"
# shellcheck source=lib/repo.sh
source "$LIB_DIR/repo.sh"
# shellcheck source=lib/deps.sh
source "$LIB_DIR/deps.sh"

# Pre-flight check: verify dependencies
for tool in sqlite3 jq; do
    if ! command -v "$tool" >/dev/null 2>&1; then
        echo "Error: required dependency '$tool' is not installed or not in PATH." >&2
        exit 1
    fi
done

# Resolve default database path
get_default_db_path() {
    if [[ -n "${RAVPKG_DB:-}" ]]; then
        echo "$RAVPKG_DB"
        return
    fi
    local root_prefix="${RAVPKG_ROOT:-}"
    if [[ -n "$root_prefix" ]]; then
        echo "${root_prefix%/}/var/db/ravpkg/pkg.db"
        return
    fi
    if [[ -w "/var/db" || -d "/var/db/ravpkg" ]]; then
        echo "/var/db/ravpkg/pkg.db"
    elif [[ -d "/var" && "$EUID" -eq 0 ]]; then
        echo "/var/db/ravpkg/pkg.db"
    else
        echo "./ravpkg.db"
    fi
}

show_help() {
    cat <<'EOF'
ravpkg is the native package manager for ravynOS, managing package
installations, removals, queries, and system manifests.

Command Status:
- list: functional (reads local SQLite package DB)
- info: functional (reads package metadata and file list)
- install: functional (transactional filesystem install with rollback)
- remove: functional (filesystem removal with missing file tolerance)
- search: functional (case-insensitive search against repository index)
- update: functional (fetch and cache remote repository index)

Usage:
  ravpkg [command]

Available Commands:
  help        Help about any command
  info        Display details and installed files for a package [FUNCTIONAL]
  install     Install a package archive or repository package by name [FUNCTIONAL]
  list        List all installed packages [FUNCTIONAL]
  remove      Remove an installed package from the system [FUNCTIONAL]
  search      Search for packages in the repository index [FUNCTIONAL]
  update      Fetch and cache the repository index [FUNCTIONAL]

Flags:
  -d, --db string       Path to SQLite database (default: /var/db/ravpkg/pkg.db or ./ravpkg.db)
  -r, --root string     Target root directory for installation (default: /)
      --repo string     Repository URL or local path to index.json
      --cache string    Path to repository index cache file
      --no-cache        Force a fresh repository index fetch before resolving
      --no-deps         Skip dependency resolution checks
      --skip-verify     Skip package checksum verification (DEVELOPMENT ONLY)
  -h, --help            help for ravpkg

Use "ravpkg [command] --help" for more information about a command.
EOF
}

# Parse global options
DB_PATH=""
REPO_URL="${RAVPKG_REPO_URL:-}"
REPO_CACHE="${RAVPKG_REPO_CACHE:-}"
ARGS=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        -d|--db)
            if [[ $# -lt 2 ]]; then
                echo "Error: flag needs an argument: --db" >&2
                exit 1
            fi
            DB_PATH="$2"
            shift 2
            ;;
        --db=*)
            DB_PATH="${1#*=}"
            shift
            ;;
        -r|--root)
            if [[ $# -lt 2 ]]; then
                echo "Error: flag needs an argument: --root" >&2
                exit 1
            fi
            export RAVPKG_ROOT="$2"
            shift 2
            ;;
        --root=*)
            export RAVPKG_ROOT="${1#*=}"
            shift
            ;;
        --no-deps|--nodeps)
            export RAVPKG_NO_DEPS=1
            shift
            ;;
        --no-cache)
            export RAVPKG_NO_CACHE=1
            shift
            ;;
        --skip-verify)
            export RAVPKG_SKIP_VERIFY=1
            shift
            ;;
        --repo)
            if [[ $# -lt 2 ]]; then
                echo "Error: flag needs an argument: --repo" >&2
                exit 1
            fi
            REPO_URL="$2"
            shift 2
            ;;
        --repo=*)
            REPO_URL="${1#*=}"
            shift
            ;;
        --cache)
            if [[ $# -lt 2 ]]; then
                echo "Error: flag needs an argument: --cache" >&2
                exit 1
            fi
            REPO_CACHE="$2"
            shift 2
            ;;
        --cache=*)
            REPO_CACHE="${1#*=}"
            shift
            ;;
        -h|--help)
            show_help
            exit 0
            ;;
        *)
            ARGS+=("$1")
            shift
            ;;
    esac
done

if [[ -z "$DB_PATH" ]]; then
    DB_PATH="$(get_default_db_path)"
fi

if [[ -z "$REPO_CACHE" ]]; then
    REPO_CACHE="$(repo_get_default_cache_path)"
fi

if [[ ${#ARGS[@]} -eq 0 ]]; then
    show_help
    exit 0
fi

COMMAND="${ARGS[0]}"
SUBARGS=("${ARGS[@]:1}")

case "$COMMAND" in
    help)
        show_help
        exit 0
        ;;

    list)
        if [[ ${#SUBARGS[@]} -gt 0 && ("${SUBARGS[0]}" == "-h" || "${SUBARGS[0]}" == "--help") ]]; then
            echo "List all installed packages [FUNCTIONAL]"
            echo ""
            echo "Usage:"
            echo "  ravpkg list"
            exit 0
        fi

        db_init "$DB_PATH" "$SCHEMA_FILE"
        packages_json="$(db_list_packages "$DB_PATH")"

        count="$(echo "$packages_json" | jq 'length' 2>/dev/null || echo 0)"
        if [[ "$count" -eq 0 ]]; then
            echo "No packages currently installed."
            exit 0
        fi

        # Format tabular output
        printf "%-15s %-10s %-20s %s\n" "NAME" "VERSION" "INSTALLED" "FILES"
        echo "$packages_json" | jq -r '.[] | [
            .name,
            .version,
            ((.install_date // "-") | sub("T"; " ") | sub("Z$"; "") | .[0:19]),
            ((.installed_files | if type == "string" then (fromjson? // []) else . end) | length)
        ] | @tsv' | while IFS=$'\t' read -r name version date files_len; do
            printf "%-15s %-10s %-20s %s\n" "$name" "$version" "$date" "$files_len"
        done
        ;;

    info)
        if [[ ${#SUBARGS[@]} -eq 0 || "${SUBARGS[0]}" == "-h" || "${SUBARGS[0]}" == "--help" ]]; then
            if [[ ${#SUBARGS[@]} -eq 0 ]]; then
                echo "Error: accepts 1 arg(s), received 0" >&2
            fi
            echo "Usage: ravpkg info <package-name>" >&2
            exit 1
        fi

        PKG_NAME="${SUBARGS[0]}"
        db_init "$DB_PATH" "$SCHEMA_FILE"

        if ! pkg_json="$(db_get_package "$DB_PATH" "$PKG_NAME" 2>/dev/null)"; then
            echo "Error: package \"$PKG_NAME\" is not installed" >&2
            exit 1
        fi

        name="$(echo "$pkg_json" | jq -r '.name')"
        version="$(echo "$pkg_json" | jq -r '.version')"
        date="$(echo "$pkg_json" | jq -r '.install_date')"
        manifest="$(echo "$pkg_json" | jq -r '.manifest_path')"
        files_str="$(echo "$pkg_json" | jq -r '.installed_files')"
        file_count="$(echo "$files_str" | jq 'if type == "string" then (fromjson? // []) else . end | length' 2>/dev/null || echo 0)"

        echo "Package:      $name"
        echo "Version:      $version"
        echo "Install Date: $date"
        echo "Manifest:     $manifest"
        echo "Files ($file_count):"
        if [[ "$file_count" -gt 0 ]]; then
            echo "$files_str" | jq -r 'if type == "string" then (fromjson? // []) else . end | .[]' | sed 's/^/  - /'
        fi
        ;;

    install)
        clean_subargs=()
        for sarg in "${SUBARGS[@]:-}"; do
            if [[ "$sarg" == "--skip-verify" ]]; then
                export RAVPKG_SKIP_VERIFY=1
            elif [[ "$sarg" == "--no-deps" || "$sarg" == "--nodeps" ]]; then
                export RAVPKG_NO_DEPS=1
            elif [[ "$sarg" == "--no-cache" ]]; then
                export RAVPKG_NO_CACHE=1
            else
                clean_subargs+=("$sarg")
            fi
        done
        if [[ ${#clean_subargs[@]} -gt 0 ]]; then
            SUBARGS=("${clean_subargs[@]}")
        else
            SUBARGS=()
        fi

        if [[ ${#SUBARGS[@]} -eq 0 || "${SUBARGS[0]}" == "-h" || "${SUBARGS[0]}" == "--help" ]]; then
            if [[ ${#SUBARGS[@]} -eq 0 ]]; then
                echo "Error: accepts 1 arg(s), received 0" >&2
            fi
            echo "Usage: ravpkg install <package-file|package-name> [--no-cache] [--skip-verify] [--no-deps]" >&2
            exit 1
        fi
        TARGET_ARG="${SUBARGS[0]}"
        db_init "$DB_PATH" "$SCHEMA_FILE"

        is_file_target=0
        if [[ -f "$TARGET_ARG" ]]; then
            is_file_target=1
        elif [[ "$TARGET_ARG" == *"/"* || "$TARGET_ARG" == *"\\"* || "$TARGET_ARG" == *.rav || "$TARGET_ARG" == *.tar* ]]; then
            is_file_target=1
        fi

        if [[ "$is_file_target" -eq 1 ]]; then
            # Direct local file install (existing behavior, unchanged)
            pkg_install "$DB_PATH" "$TARGET_ARG"
        else
            # Package name: resolve via repository index
            if [[ -z "$REPO_CACHE" ]]; then
                REPO_CACHE="$(repo_get_default_cache_path)"
            fi
            if [[ -z "$REPO_URL" ]]; then
                REPO_URL="${DEFAULT_REPO_URL:-https://repo.ravynos.com/index.json}"
            fi

            # Check if index needs to be fetched or refreshed
            if [[ "${RAVPKG_NO_CACHE:-0}" == "1" || ! -f "$REPO_CACHE" ]]; then
                echo "[REPO] Updating repository index from $REPO_URL..."
                if ! repo_fetch_index "$REPO_URL" "$REPO_CACHE"; then
                    echo "Error: failed to fetch repository index from '$REPO_URL'" >&2
                    exit 1
                fi
            fi

            # Look up package in index
            pkg_entry="$(repo_lookup_package "$REPO_CACHE" "$TARGET_ARG" || true)"
            if [[ -z "$pkg_entry" || "$pkg_entry" == "null" ]]; then
                echo "Error: package '$TARGET_ARG' not found in repository index." >&2
                exit 1
            fi

            dl_url="$(echo "$pkg_entry" | jq -r '.download_url // empty')"
            idx_checksum="$(echo "$pkg_entry" | jq -r '.checksum // empty')"
            pkg_ver="$(echo "$pkg_entry" | jq -r '.version // empty')"

            if [[ -z "$dl_url" || -z "$idx_checksum" ]]; then
                echo "Error: repository entry for '$TARGET_ARG' is missing download_url or checksum." >&2
                exit 1
            fi

            resolved_url="$(repo_resolve_url "$REPO_URL" "$dl_url")"

            TMP_PKG="$(mktemp 2>/dev/null || mktemp -t 'ravpkg-dl-XXXXXX.rav')"
            _clean_tmp_pkg() {
                if [[ -n "${TMP_PKG:-}" && -f "$TMP_PKG" ]]; then
                    rm -f "$TMP_PKG"
                fi
            }
            trap '_clean_tmp_pkg' EXIT INT TERM ERR

            echo "[REPO] Downloading $TARGET_ARG ($pkg_ver) from $resolved_url..."
            if ! repo_download_package "$resolved_url" "$TMP_PKG"; then
                echo "Error: failed to download package '$TARGET_ARG' from '$resolved_url'" >&2
                _clean_tmp_pkg
                trap - EXIT INT TERM ERR
                exit 1
            fi

            # Check 1: Verify downloaded file against repository index checksum BEFORE install
            if [[ "${RAVPKG_SKIP_VERIFY:-0}" != "1" ]]; then
                if ! repo_verify_checksum "$TMP_PKG" "$idx_checksum"; then
                    actual_dl_cs="$(_calc_sha256 "$TMP_PKG" | tr -d '\r')"
                    echo "Error: checksum mismatch between downloaded package and repository index for '$TARGET_ARG'!" >&2
                    echo "  Index checksum:      $idx_checksum" >&2
                    echo "  Downloaded file:     $actual_dl_cs" >&2
                    echo "Download rejected. Integrity cannot be verified." >&2
                    _clean_tmp_pkg
                    trap - EXIT INT TERM ERR
                    exit 1
                fi
            fi

            # Check 2: Verify agreement between repository index checksum and package manifest checksum
            manifest_cs="$(tar -xf "$TMP_PKG" -O manifest.json 2>/dev/null | jq -r '.checksum // empty' 2>/dev/null | tr -d '\r' || true)"
            if [[ "${RAVPKG_SKIP_VERIFY:-0}" != "1" ]]; then
                if [[ -n "$manifest_cs" && -n "$idx_checksum" && "$manifest_cs" != "$idx_checksum" ]]; then
                    echo "Error: checksum disagreement between repository index and package manifest for '$TARGET_ARG'!" >&2
                    echo "  Repository index: $idx_checksum" >&2
                    echo "  Package manifest: $manifest_cs" >&2
                    echo "Installation rejected: repository index and manifest must agree." >&2
                    _clean_tmp_pkg
                    trap - EXIT INT TERM ERR
                    exit 1
                fi
            fi

            pkg_install "$DB_PATH" "$TMP_PKG"
            inst_rc=$?

            _clean_tmp_pkg
            trap - EXIT INT TERM ERR
            exit $inst_rc
        fi
        ;;

    remove)
        if [[ ${#SUBARGS[@]} -eq 0 || "${SUBARGS[0]}" == "-h" || "${SUBARGS[0]}" == "--help" ]]; then
            if [[ ${#SUBARGS[@]} -eq 0 ]]; then
                echo "Error: accepts 1 arg(s), received 0" >&2
            fi
            echo "Usage: ravpkg remove <package-name>" >&2
            exit 1
        fi
        PKG_NAME="${SUBARGS[0]}"
        db_init "$DB_PATH" "$SCHEMA_FILE"
        pkg_remove "$DB_PATH" "$PKG_NAME"
        ;;

    search)
        if [[ ${#SUBARGS[@]} -eq 0 || "${SUBARGS[0]}" == "-h" || "${SUBARGS[0]}" == "--help" ]]; then
            if [[ ${#SUBARGS[@]} -eq 0 ]]; then
                echo "Error: accepts 1 arg(s), received 0" >&2
            fi
            echo "Usage: ravpkg search <query>" >&2
            exit 1
        fi
        QUERY="${SUBARGS[0]}"

        # If --repo was explicitly provided, populate or update the cache from that source
        if [[ -n "$REPO_URL" ]]; then
            if ! repo_fetch_index "$REPO_URL" "$REPO_CACHE"; then
                exit 1
            fi
        fi

        if ! repo_search "$REPO_CACHE" "$QUERY"; then
            exit 1
        fi
        ;;

    update)
        if [[ ${#SUBARGS[@]} -gt 0 && ("${SUBARGS[0]}" == "-h" || "${SUBARGS[0]}" == "--help") ]]; then
            echo "Fetch and cache repository index [FUNCTIONAL]"
            echo ""
            echo "Usage:"
            echo "  ravpkg update"
            exit 0
        fi

        repo_source="${REPO_URL:-$DEFAULT_REPO_URL}"
        echo "[REPO] Fetching repository index from $repo_source..."
        if repo_fetch_index "$repo_source" "$REPO_CACHE"; then
            pkg_count="$(jq 'length' "$REPO_CACHE" 2>/dev/null || echo 0)"
            echo "Successfully updated repository index ($pkg_count package(s) available)."
        else
            echo "Error: failed to update repository index" >&2
            exit 1
        fi
        ;;

    *)
        echo "Error: unknown command \"$COMMAND\" for \"ravpkg\"" >&2
        echo "Run 'ravpkg --help' for usage." >&2
        exit 1
        ;;
esac
