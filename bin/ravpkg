#!/usr/bin/env bash
# bin/ravpkg - Main executable for ravynOS package manager
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(dirname "$SCRIPT_DIR")"

# Determine library directory location
if [[ -f "$ROOT_DIR/lib/db.sh" ]]; then
    LIB_DIR="$ROOT_DIR/lib"
    SCHEMA_FILE="$ROOT_DIR/schema/schema.sql"
elif [[ -f "/usr/local/lib/ravpkg/db.sh" ]]; then
    LIB_DIR="/usr/local/lib/ravpkg"
    SCHEMA_FILE="/usr/local/lib/ravpkg/schema.sql"
elif [[ -f "/usr/lib/ravpkg/db.sh" ]]; then
    LIB_DIR="/usr/lib/ravpkg"
    SCHEMA_FILE="/usr/lib/ravpkg/schema.sql"
else
    echo "Error: unable to locate ravpkg libraries (lib/db.sh)" >&2
    exit 1
fi

# Source core engine libraries
# shellcheck source=lib/db.sh
source "$LIB_DIR/db.sh"
# shellcheck source=lib/parser.sh
source "$LIB_DIR/parser.sh"
# shellcheck source=lib/install.sh
source "$LIB_DIR/install.sh"
# shellcheck source=lib/remove.sh
source "$LIB_DIR/remove.sh"
# shellcheck source=lib/repo.sh
source "$LIB_DIR/repo.sh"
# shellcheck source=lib/deps.sh
source "$LIB_DIR/deps.sh"

# Pre-flight check: verify dependencies
for tool in sqlite3 jq; do
    if ! command -v "$tool" >/dev/null 2>&1; then
        echo "Error: required dependency '$tool' is not installed or not in PATH." >&2
        exit 1
    fi
done

# Resolve default database path
get_default_db_path() {
    if [[ -n "${RAVPKG_DB:-}" ]]; then
        echo "$RAVPKG_DB"
        return
    fi
    local root_prefix="${RAVPKG_ROOT:-}"
    if [[ -n "$root_prefix" ]]; then
        echo "${root_prefix%/}/var/db/ravpkg/pkg.db"
        return
    fi
    if [[ -w "/var/db" || -d "/var/db/ravpkg" ]]; then
        echo "/var/db/ravpkg/pkg.db"
    elif [[ -d "/var" && "$EUID" -eq 0 ]]; then
        echo "/var/db/ravpkg/pkg.db"
    else
        echo "./ravpkg.db"
    fi
}

show_help() {
    cat <<'EOF'
ravpkg is the native package manager for ravynOS, managing package
installations, removals, queries, and system manifests.

Command Status:
- list: functional (reads local SQLite package DB)
- info: functional (reads package metadata and file list)
- install: functional (transactional filesystem install with rollback)
- remove: functional (filesystem removal with missing file tolerance)
- search: functional (case-insensitive search against repository index)
- update: functional (fetch and cache remote repository index)

Usage:
  ravpkg [command]

Available Commands:
  help        Help about any command
  info        Display details and installed files for a package [FUNCTIONAL]
  install     Install a package archive or repository package by name [FUNCTIONAL]
  list        List all installed packages [FUNCTIONAL]
  remove      Remove an installed package from the system [FUNCTIONAL]
  search      Search for packages in the repository index [FUNCTIONAL]
  update      Fetch and cache the repository index [FUNCTIONAL]

Flags:
  -d, --db string       Path to SQLite database (default: /var/db/ravpkg/pkg.db or ./ravpkg.db)
  -r, --root string     Target root directory for installation (default: /)
      --repo string     Repository URL or local path to index.json
      --cache string    Path to repository index cache file
      --no-cache        Force a fresh repository index fetch before resolving
      --no-deps         Skip dependency resolution checks
      --skip-verify     Skip package checksum verification (DEVELOPMENT ONLY)
  -y, --yes             Automatically answer yes to confirmation prompts
  -h, --help            help for ravpkg

Use "ravpkg [command] --help" for more information about a command.
EOF
}

# Parse global options
DB_PATH=""
REPO_URL="${RAVPKG_REPO_URL:-}"
REPO_CACHE="${RAVPKG_REPO_CACHE:-}"
ARGS=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        -d|--db)
            if [[ $# -lt 2 ]]; then
                echo "Error: flag needs an argument: --db" >&2
                exit 1
            fi
            DB_PATH="$2"
            shift 2
            ;;
        --db=*)
            DB_PATH="${1#*=}"
            shift
            ;;
        -r|--root)
            if [[ $# -lt 2 ]]; then
                echo "Error: flag needs an argument: --root" >&2
                exit 1
            fi
            export RAVPKG_ROOT="$2"
            shift 2
            ;;
        --root=*)
            export RAVPKG_ROOT="${1#*=}"
            shift
            ;;
        --no-deps|--nodeps)
            export RAVPKG_NO_DEPS=1
            shift
            ;;
        --no-cache)
            export RAVPKG_NO_CACHE=1
            shift
            ;;
        -y|--yes)
            export RAVPKG_YES=1
            shift
            ;;
        --skip-verify)
            export RAVPKG_SKIP_VERIFY=1
            shift
            ;;
        --repo)
            if [[ $# -lt 2 ]]; then
                echo "Error: flag needs an argument: --repo" >&2
                exit 1
            fi
            REPO_URL="$2"
            shift 2
            ;;
        --repo=*)
            REPO_URL="${1#*=}"
            shift
            ;;
        --cache)
            if [[ $# -lt 2 ]]; then
                echo "Error: flag needs an argument: --cache" >&2
                exit 1
            fi
            REPO_CACHE="$2"
            shift 2
            ;;
        --cache=*)
            REPO_CACHE="${1#*=}"
            shift
            ;;
        -h|--help)
            show_help
            exit 0
            ;;
        *)
            ARGS+=("$1")
            shift
            ;;
    esac
done

if [[ -z "$DB_PATH" ]]; then
    DB_PATH="$(get_default_db_path)"
fi

if [[ -z "$REPO_CACHE" ]]; then
    REPO_CACHE="$(repo_get_default_cache_path)"
fi

if [[ ${#ARGS[@]} -eq 0 ]]; then
    show_help
    exit 0
fi

COMMAND="${ARGS[0]}"
SUBARGS=("${ARGS[@]:1}")

case "$COMMAND" in
    help)
        show_help
        exit 0
        ;;

    list)
        if [[ ${#SUBARGS[@]} -gt 0 && ("${SUBARGS[0]}" == "-h" || "${SUBARGS[0]}" == "--help") ]]; then
            echo "List all installed packages [FUNCTIONAL]"
            echo ""
            echo "Usage:"
            echo "  ravpkg list"
            exit 0
        fi

        db_init "$DB_PATH" "$SCHEMA_FILE"
        packages_json="$(db_list_packages "$DB_PATH")"

        count="$(echo "$packages_json" | jq 'length' 2>/dev/null || echo 0)"
        if [[ "$count" -eq 0 ]]; then
            echo "No packages currently installed."
            exit 0
        fi

        # Format tabular output
        printf "%-15s %-10s %-20s %s\n" "NAME" "VERSION" "INSTALLED" "FILES"
        echo "$packages_json" | jq -r '.[] | [
            .name,
            .version,
            ((.install_date // "-") | sub("T"; " ") | sub("Z$"; "") | .[0:19]),
            ((.installed_files | if type == "string" then (fromjson? // []) else . end) | length)
        ] | @tsv' | while IFS=$'\t' read -r name version date files_len; do
            printf "%-15s %-10s %-20s %s\n" "$name" "$version" "$date" "$files_len"
        done
        ;;

    info)
        if [[ ${#SUBARGS[@]} -eq 0 || "${SUBARGS[0]}" == "-h" || "${SUBARGS[0]}" == "--help" ]]; then
            if [[ ${#SUBARGS[@]} -eq 0 ]]; then
                echo "Error: accepts 1 arg(s), received 0" >&2
            fi
            echo "Usage: ravpkg info <package-name>" >&2
            exit 1
        fi

        PKG_NAME="${SUBARGS[0]}"
        db_init "$DB_PATH" "$SCHEMA_FILE"

        if ! pkg_json="$(db_get_package "$DB_PATH" "$PKG_NAME" 2>/dev/null)"; then
            echo "Error: package \"$PKG_NAME\" is not installed" >&2
            exit 1
        fi

        name="$(echo "$pkg_json" | jq -r '.name')"
        version="$(echo "$pkg_json" | jq -r '.version')"
        date="$(echo "$pkg_json" | jq -r '.install_date')"
        manifest="$(echo "$pkg_json" | jq -r '.manifest_path')"
        files_str="$(echo "$pkg_json" | jq -r '.installed_files')"
        file_count="$(echo "$files_str" | jq 'if type == "string" then (fromjson? // []) else . end | length' 2>/dev/null || echo 0)"

        echo "Package:      $name"
        echo "Version:      $version"
        echo "Install Date: $date"
        echo "Manifest:     $manifest"
        echo "Files ($file_count):"
        if [[ "$file_count" -gt 0 ]]; then
            echo "$files_str" | jq -r 'if type == "string" then (fromjson? // []) else . end | .[]' | sed 's/^/  - /'
        fi
        ;;

    install)
        clean_subargs=()
        for sarg in "${SUBARGS[@]:-}"; do
            if [[ "$sarg" == "--skip-verify" ]]; then
                export RAVPKG_SKIP_VERIFY=1
            elif [[ "$sarg" == "--no-deps" || "$sarg" == "--nodeps" ]]; then
                export RAVPKG_NO_DEPS=1
            elif [[ "$sarg" == "--no-cache" ]]; then
                export RAVPKG_NO_CACHE=1
            elif [[ "$sarg" == "--yes" || "$sarg" == "-y" ]]; then
                export RAVPKG_YES=1
            else
                clean_subargs+=("$sarg")
            fi
        done
        if [[ ${#clean_subargs[@]} -gt 0 ]]; then
            SUBARGS=("${clean_subargs[@]}")
        else
            SUBARGS=()
        fi

        if [[ ${#SUBARGS[@]} -eq 0 || "${SUBARGS[0]}" == "-h" || "${SUBARGS[0]}" == "--help" ]]; then
            if [[ ${#SUBARGS[@]} -eq 0 ]]; then
                echo "Error: accepts 1 arg(s), received 0" >&2
            fi
            echo "Usage: ravpkg install <package-file|package-name> [-y|--yes] [--no-cache] [--skip-verify] [--no-deps]" >&2
            exit 1
        fi
        TARGET_ARG="${SUBARGS[0]}"
        db_init "$DB_PATH" "$SCHEMA_FILE"

        if [[ -z "$REPO_CACHE" ]]; then
            REPO_CACHE="$(repo_get_default_cache_path)"
        fi
        if [[ -z "$REPO_URL" ]]; then
            REPO_URL="${DEFAULT_REPO_URL:-https://repo.ravynos.com/index.json}"
        fi

        is_file_target=0
        if [[ -f "$TARGET_ARG" ]]; then
            is_file_target=1
        elif [[ "$TARGET_ARG" == *"/"* || "$TARGET_ARG" == *"\\"* || "$TARGET_ARG" == *.rav || "$TARGET_ARG" == *.tar* ]]; then
            is_file_target=1
        fi

        target_manifest=""
        target_name=""
        target_ver=""
        target_dl_url=""
        target_idx_cs=""

        if [[ "$is_file_target" -eq 1 ]]; then
            if [[ ! -f "$TARGET_ARG" ]]; then
                echo "Error: package file does not exist: $TARGET_ARG" >&2
                exit 1
            fi
            target_manifest="$(tar -xf "$TARGET_ARG" -O manifest.json 2>/dev/null || cat "$TARGET_ARG" 2>/dev/null || true)"
            if [[ -z "$target_manifest" ]]; then
                echo "Error: invalid package archive (missing manifest.json): $TARGET_ARG" >&2
                exit 1
            fi
            target_name="$(manifest_get_name "$target_manifest" 2>/dev/null || echo "")"
            target_ver="$(manifest_get_version "$target_manifest" 2>/dev/null || echo "")"
        else
            # Package name: ensure repo index is fetched or updated
            if [[ "${RAVPKG_NO_CACHE:-0}" == "1" || ! -f "$REPO_CACHE" ]]; then
                echo "[REPO] Updating repository index from $REPO_URL..."
                if ! repo_fetch_index "$REPO_URL" "$REPO_CACHE"; then
                    echo "Error: failed to fetch repository index from '$REPO_URL'" >&2
                    exit 1
                fi
            fi

            pkg_entry="$(repo_lookup_package "$REPO_CACHE" "$TARGET_ARG" || true)"
            if [[ -z "$pkg_entry" || "$pkg_entry" == "null" ]]; then
                echo "Error: package '$TARGET_ARG' not found in repository index." >&2
                exit 1
            fi

            target_manifest="$pkg_entry"
            target_name="$(echo "$pkg_entry" | jq -r '.name // empty')"
            target_ver="$(echo "$pkg_entry" | jq -r '.version // empty')"
            target_dl_url="$(echo "$pkg_entry" | jq -r '.download_url // empty')"
            target_idx_cs="$(echo "$pkg_entry" | jq -r '.checksum // empty')"

            if [[ -z "$target_dl_url" || -z "$target_idx_cs" ]]; then
                echo "Error: repository entry for '$TARGET_ARG' is missing download_url or checksum." >&2
                exit 1
            fi
        fi

        # Check package conflicts with currently installed packages
        if ! check_package_conflicts "$target_manifest" "$DB_PATH" "${RAVPKG_ROOT:-}"; then
            exit 1
        fi

        # Build install plan for missing dependencies
        plan_json="[]"
        deps_count=0
        if [[ "${RAVPKG_NO_DEPS:-0}" != "1" ]]; then
            # Ensure index cache is populated if not already present
            if [[ ! -f "$REPO_CACHE" ]]; then
                repo_fetch_index "$REPO_URL" "$REPO_CACHE" 2>/dev/null || true
            fi

            if ! plan_json="$(deps_build_install_plan "$target_name" "$target_manifest" "$DB_PATH" "$REPO_CACHE" "${RAVPKG_ROOT:-}")"; then
                exit 1
            fi
            deps_count="$(echo "$plan_json" | jq 'length' 2>/dev/null || echo 0)"
        fi

        # Display transaction summary and prompt confirmation
        if [[ "$deps_count" -gt 0 ]]; then
            echo ""
            echo "================================================================================"
            echo "                           Transaction Summary"
            echo "================================================================================"
            echo "Target Package:"
            echo "  - $target_name ($target_ver)"
            echo ""
            echo "Dependencies to be installed from repository ($deps_count):"
            for ((p=0; p<deps_count; p++)); do
                p_name="$(echo "$plan_json" | jq -r ".[$p].name")"
                p_ver="$(echo "$plan_json" | jq -r ".[$p].version")"
                p_req="$(echo "$plan_json" | jq -r ".[$p].required_by")"
                p_cs="$(echo "$plan_json" | jq -r ".[$p].constraint")"
                printf "  %2d. %-18s %-10s (required by: %s, constraint: %s)\n" "$((p+1))" "$p_name" "$p_ver" "$p_req" "$p_cs"
            done
            echo ""
            echo "Total packages to install: $((deps_count + 1))"
            echo "================================================================================"
            echo ""

            if [[ "${RAVPKG_YES:-0}" != "1" ]]; then
                read -r -p "Proceed with installation? [y/N]: " confirm_ans
                if [[ "$confirm_ans" != "y" && "$confirm_ans" != "Y" ]]; then
                    echo "Installation cancelled by user." >&2
                    exit 1
                fi
            fi
        fi

        # Execute transaction with full rollback tracking
        INSTALLED_IN_TRANSACTION=()

        _rollback_transaction() {
            local failed_pkg="$1"
            echo "" >&2
            echo "==========================================================================" >&2
            echo "Transaction failed during installation of '$failed_pkg'!" >&2
            if [[ ${#INSTALLED_IN_TRANSACTION[@]} -gt 0 ]]; then
                echo "Executing full transaction rollback: uninstalling previously installed packages..." >&2
                for ((rb=${#INSTALLED_IN_TRANSACTION[@]}-1; rb>=0; rb--)); do
                    local rb_pkg="${INSTALLED_IN_TRANSACTION[rb]}"
                    echo "[ROLLBACK] Uninstalling package '$rb_pkg'..." >&2
                    pkg_remove "$DB_PATH" "$rb_pkg" >/dev/null 2>&1 || true
                done
                echo "Full transaction rollback complete. System restored to pre-transaction state." >&2
            fi
            echo "==========================================================================" >&2
        }

        # Install dependencies in topological order
        for ((p=0; p<deps_count; p++)); do
            dep_item="$(echo "$plan_json" | jq -c ".[$p]")"
            dep_name="$(echo "$dep_item" | jq -r '.name')"
            dep_ver="$(echo "$dep_item" | jq -r '.version')"
            dep_url="$(echo "$dep_item" | jq -r '.download_url')"
            dep_cs="$(echo "$dep_item" | jq -r '.checksum')"

            resolved_dep_url="$(repo_resolve_url "$REPO_URL" "$dep_url")"
            TMP_DEP="$(mktemp 2>/dev/null || mktemp -t 'ravpkg-dep-XXXXXX.rav')"

            echo "[TRANSACTION] ($((p+1))/$((deps_count+1))) Downloading dependency $dep_name ($dep_ver)..."
            if ! repo_download_package "$resolved_dep_url" "$TMP_DEP"; then
                echo "Error: failed to download dependency '$dep_name' from '$resolved_dep_url'" >&2
                rm -f "$TMP_DEP"
                _rollback_transaction "$dep_name"
                exit 1
            fi

            if [[ "${RAVPKG_SKIP_VERIFY:-0}" != "1" ]]; then
                if ! repo_verify_checksum "$TMP_DEP" "$dep_cs"; then
                    echo "Error: checksum mismatch between downloaded dependency '$dep_name' and index!" >&2
                    rm -f "$TMP_DEP"
                    _rollback_transaction "$dep_name"
                    exit 1
                fi
                dep_manifest_cs="$(tar -xf "$TMP_DEP" -O manifest.json 2>/dev/null | jq -r '.checksum // empty' 2>/dev/null | tr -d '\r' || true)"
                if [[ -n "$dep_manifest_cs" && -n "$dep_cs" && "$dep_manifest_cs" != "$dep_cs" ]]; then
                    echo "Error: checksum disagreement between index and manifest for dependency '$dep_name'!" >&2
                    rm -f "$TMP_DEP"
                    _rollback_transaction "$dep_name"
                    exit 1
                fi
            fi

            echo "[TRANSACTION] ($((p+1))/$((deps_count+1))) Installing dependency $dep_name ($dep_ver)..."
            if ! pkg_install "$DB_PATH" "$TMP_DEP"; then
                rm -f "$TMP_DEP"
                _rollback_transaction "$dep_name"
                exit 1
            fi
            rm -f "$TMP_DEP"
            INSTALLED_IN_TRANSACTION+=("$dep_name")
        done

        # Install target package
        if [[ "$is_file_target" -eq 1 ]]; then
            echo "[TRANSACTION] ($((deps_count+1))/$((deps_count+1))) Installing target package $target_name ($target_ver)..."
            if ! pkg_install "$DB_PATH" "$TARGET_ARG"; then
                _rollback_transaction "$target_name"
                exit 1
            fi
        else
            resolved_target_url="$(repo_resolve_url "$REPO_URL" "$target_dl_url")"
            TMP_TARGET="$(mktemp 2>/dev/null || mktemp -t 'ravpkg-target-XXXXXX.rav')"

            echo "[TRANSACTION] ($((deps_count+1))/$((deps_count+1))) Downloading target package $target_name ($target_ver)..."
            if ! repo_download_package "$resolved_target_url" "$TMP_TARGET"; then
                echo "Error: failed to download target package '$target_name' from '$resolved_target_url'" >&2
                rm -f "$TMP_TARGET"
                _rollback_transaction "$target_name"
                exit 1
            fi

            if [[ "${RAVPKG_SKIP_VERIFY:-0}" != "1" ]]; then
                if ! repo_verify_checksum "$TMP_TARGET" "$target_idx_cs"; then
                    echo "Error: checksum mismatch between downloaded target package '$target_name' and index!" >&2
                    rm -f "$TMP_TARGET"
                    _rollback_transaction "$target_name"
                    exit 1
                fi
                target_manifest_cs="$(tar -xf "$TMP_TARGET" -O manifest.json 2>/dev/null | jq -r '.checksum // empty' 2>/dev/null | tr -d '\r' || true)"
                if [[ -n "$target_manifest_cs" && -n "$target_idx_cs" && "$target_manifest_cs" != "$target_idx_cs" ]]; then
                    echo "Error: checksum disagreement between index and manifest for target package '$target_name'!" >&2
                    rm -f "$TMP_TARGET"
                    _rollback_transaction "$target_name"
                    exit 1
                fi
            fi

            echo "[TRANSACTION] ($((deps_count+1))/$((deps_count+1))) Installing target package $target_name ($target_ver)..."
            if ! pkg_install "$DB_PATH" "$TMP_TARGET"; then
                rm -f "$TMP_TARGET"
                _rollback_transaction "$target_name"
                exit 1
            fi
            rm -f "$TMP_TARGET"
        fi
        ;;

    remove)
        if [[ ${#SUBARGS[@]} -eq 0 || "${SUBARGS[0]}" == "-h" || "${SUBARGS[0]}" == "--help" ]]; then
            if [[ ${#SUBARGS[@]} -eq 0 ]]; then
                echo "Error: accepts 1 arg(s), received 0" >&2
            fi
            echo "Usage: ravpkg remove <package-name>" >&2
            exit 1
        fi
        PKG_NAME="${SUBARGS[0]}"
        db_init "$DB_PATH" "$SCHEMA_FILE"
        pkg_remove "$DB_PATH" "$PKG_NAME"
        ;;

    search)
        if [[ ${#SUBARGS[@]} -eq 0 || "${SUBARGS[0]}" == "-h" || "${SUBARGS[0]}" == "--help" ]]; then
            if [[ ${#SUBARGS[@]} -eq 0 ]]; then
                echo "Error: accepts 1 arg(s), received 0" >&2
            fi
            echo "Usage: ravpkg search <query>" >&2
            exit 1
        fi
        QUERY="${SUBARGS[0]}"

        # If --repo was explicitly provided, populate or update the cache from that source
        if [[ -n "$REPO_URL" ]]; then
            if ! repo_fetch_index "$REPO_URL" "$REPO_CACHE"; then
                exit 1
            fi
        fi

        if ! repo_search "$REPO_CACHE" "$QUERY"; then
            exit 1
        fi
        ;;

    update)
        if [[ ${#SUBARGS[@]} -gt 0 && ("${SUBARGS[0]}" == "-h" || "${SUBARGS[0]}" == "--help") ]]; then
            echo "Fetch and cache repository index [FUNCTIONAL]"
            echo ""
            echo "Usage:"
            echo "  ravpkg update"
            exit 0
        fi

        repo_source="${REPO_URL:-$DEFAULT_REPO_URL}"
        echo "[REPO] Fetching repository index from $repo_source..."
        if repo_fetch_index "$repo_source" "$REPO_CACHE"; then
            pkg_count="$(jq 'length' "$REPO_CACHE" 2>/dev/null || echo 0)"
            echo "Successfully updated repository index ($pkg_count package(s) available)."
        else
            echo "Error: failed to update repository index" >&2
            exit 1
        fi
        ;;

    *)
        echo "Error: unknown command \"$COMMAND\" for \"ravpkg\"" >&2
        echo "Run 'ravpkg --help' for usage." >&2
        exit 1
        ;;
esac
